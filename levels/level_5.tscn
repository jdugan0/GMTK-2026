[sub_resource type="Resource" id="Resource_r02ll"]
script = ExtResource("3_26h77")
line = "It is a long while until the next cave, I should keep an eye out for blood bags."
metadata/_custom_type_script = "uid://igoeetpdrmgg"

[sub_resource type="Resource" id="Resource_1y5xd"]
script = ExtResource("3_26h77")
line = "That vampire slayer and I have such a long history. It can't be over now."
metadata/_custom_type_script = "uid://igoeetpdrmgg"

[sub_resource type="Resource" id="Resource_26h77"]
script = ExtResource("3_26h77")
line = "I was hungry! What did they expect me to do! It isn't my fault!"
metadata/_custom_type_script = "uid://igoeetpdrmgg"

[sub_resource type="Resource" id="Resource_g5mgy"]
script = ExtResource("3_26h77")
line = "I don't want to die."
metadata/_custom_type_script = "uid://igoeetpdrmgg"

[sub_resource type="Resource" id="Resource_v5ho1"]
script = ExtResource("3_26h77")
line = "Was it always so quiet here?"
metadata/_custom_type_script = "uid://igoeetpdrmgg"

[sub_resource type="Resource" id="Resource_ldpug"]
script = ExtResource("3_26h77")
line = "I'm weaker than I thought, I better hurry."
metadata/_custom_type_script = "uid://igoeetpdrmgg"

